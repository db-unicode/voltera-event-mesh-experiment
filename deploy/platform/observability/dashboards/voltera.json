          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "id": 16,
      "title": "Totales en la ventana",
      "description": "Eventos publicados a la malla y recibidos en billing durante el rango seleccionado.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(mesh_published_total{region=~\"$region\"}[$__range]))",
          "legendFormat": "publicados",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(billing_received_total{region=~\"$region\"}[$__range]))",
          "legendFormat": "recibidos en billing",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "id": 17,
      "title": "Zero Trust",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Conexiones TCP por política de seguridad",
      "description": "Tasa de conexiones abiertas (reporter destination) por connection_security_policy: mutual_tls frente a none.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (connection_security_policy)(rate(istio_tcp_connections_opened_total{reporter=\"destination\", namespace=~\"voltera-($region)|voltera-global|voltera-infra\"}[1m]))",
          "legendFormat": "{{connection_security_policy}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
