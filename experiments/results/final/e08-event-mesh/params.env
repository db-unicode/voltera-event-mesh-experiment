# Parámetros globales de los experimentos (POSIX KEY=value; se carga con `.`).
# Fuente: sección 2 de 03-experiments.md. Un comentario por línea o tras el valor.
DECL_PERIOD_S=60        # real; los spikes usan 10 (escala 1/6) y E7 corre 1 vez a escala real
VIEW_TTL_S=150          # 2.5 ciclos
METERS_R1=3000          # a 30 s = 100 decl/s
METERS_R2=100
MATCH_WINDOW_S=2
KAFKA_PARTITIONS=6      # energy-matched
KEDA_POLL_S=5
KEDA_COOLDOWN_S=30
KEDA_MAX_REPLICAS=10
HPA_SCALEDOWN_STABILIZATION_S=30   # el default de HPA es 300 s y ocultaría el scale-in
REPS=3                  # repeticiones por experimento final
C_POD=46                # msgs/s que procesa un pod de declaration-gateway (medido en S5)
SPIKE_RATE=276          # min(6 x C_POD, 1500)
KEDA_QUEUE_VALUE=230    # C_POD x 5 s (retraso de cola tolerado)
